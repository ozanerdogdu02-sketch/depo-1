# Sunucu portu
PORT=3001

# Vite dev sunucusunun adresi (CORS için)
CORS_ORIGIN=http://localhost:5173

# Anthropic API anahtarı — SADECE sunucuda tutulur, istemciye asla gönderilmez.
# Boş bırakılırsa uygulama "demo modu"nda çalışır (şablon yanıtlar).
ANTHROPIC_API_KEY=

# Kullanılacak model (opsiyonel)
AI_MODEL=claude-opus-4-8

# Oturum jetonlarını imzalamak için rastgele uzun bir dize
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Admin paneli (/admin) erişim anahtarı — boşsa panel kapalıdır
ADMIN_KEY=

# --- FAGENT / Netlify Function ---
# TCMB EVDS API anahtarı (https://evds2.tcmb.gov.tr → kayıt → Profil → API Anahtarı).
# YALNIZCA Netlify'ın ortam değişkenlerinde tanımlanır — istemci koduna ASLA girmez.
# Tanımsızsa canlı enflasyon kapalı kalır; uygulama elle girilen varsayımla tam çalışmaya devam eder.
EVDS_API_KEY=
