# ─────────────────────────────────────────────────────────────────────────────
# FİNANSAL JARVİS — ayarlar
# Bu dosyayı `.env` olarak kopyala ve doldur:  cp .env.example .env
# `.env` asla git'e girmez (.gitignore'da).
# ─────────────────────────────────────────────────────────────────────────────

# ── ZORUNLU: Telegram ────────────────────────────────────────────────────────
# Telegram'da @BotFather'a /newbot yazarak bot oluştur, verdiği token'ı buraya koy.
TELEGRAM_BOT_TOKEN=

# SADECE bu chat id'ye cevap verilir — başka herkes sessizce yok sayılır.
# Kendi id'ni öğrenmek için: botuna /start yaz, `npm run doctor` çıktısı sana id'yi söyler.
# Birden fazla id için virgülle ayır (ör. telefonun + tabletin aynı hesapsa gerekmez).
OWNER_CHAT_ID=

# ── Saat dilimi (brifing saatlerinin doğru çalışması için kritik) ────────────
TZ=Europe/Istanbul

# ── Veritabanı ───────────────────────────────────────────────────────────────
# Tek dosyalık SQLite. Docker'da bu yol kalıcı volume'e denk gelir.
DB_PATH=./data/jarvis.db

# ── Beyin (Ollama — yerel model, API anahtarı gerektirmez) ───────────────────
# Docker compose ile çalışıyorsan: http://ollama:11434
# Kendi bilgisayarında Ollama kuruluysa: http://127.0.0.1:11434
OLLAMA_URL=http://127.0.0.1:11434

# Varsayılan model. ~6 GB boş RAM ister.
# Sunucun küçükse: qwen2.5:3b-instruct  (~3 GB, Türkçesi biraz daha zayıf)
OLLAMA_MODEL=qwen2.5:7b-instruct

# auto = Ollama'ya ulaşılabiliyorsa kullan, ulaşılamıyorsa kural tabanlı yedeğe düş.
# false = modeli hiç kullanma (Jarvis yine tam çalışır, sadece daha kuru konuşur).
OLLAMA_MODE=auto

# ── Ses (opsiyonel — docker compose --profile voice ile açılır) ──────────────
# Kapalıysa sesli mesajlara "ses servisi kapalı" der, metin akışı etkilenmez.
VOICE_ENABLED=false
VOICE_URL=http://voice:5002

# ── Zamanlama (cron, yukarıdaki TZ'ye göre yorumlanır) ───────────────────────
# Sabah brifingi — hafta içi 09:00 (BIST açılışından hemen önce)
BRIEFING_MORNING_CRON=0 9 * * 1-5
# Kapanış özeti — hafta içi 18:30 (BIST kapanışından sonra)
BRIEFING_CLOSE_CRON=30 18 * * 1-5
# Alarm yoklaması — 15 dakikada bir
ALERT_POLL_CRON=*/15 * * * *

# ── Finansal varsayımlar ─────────────────────────────────────────────────────
# Reel getiri (enflasyona karşı alım gücü) hesabında kullanılır.
# Uydurma bir oran gömmüyoruz — bu senin varsayımın, istediğin zaman değiştir.
INFLATION_PCT=40

# ── Ağ ───────────────────────────────────────────────────────────────────────
HTTP_TIMEOUT_MS=12000
# Fiyat önbelleği ömrü (saniye). CoinGecko hız sınırına takılmamak için düşürme.
CACHE_TTL_SEC=300
